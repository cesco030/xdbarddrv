     A                                  6  2'Type options, press Enter.'
     A                                      COLOR(BLU)
     A                                  7  4'2=Change  3=Copy  4=Delete  5=Disp-
     A                                      lay  7=Options  8=RDB entry  9=Test'
     A                                      COLOR(BLU)
